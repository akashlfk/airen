# ───────────────────────────────────────────────────────────────────────
#  Airen — local dev environment
#  Copy this file to .env (which is gitignored) and fill in real values.
#  Never commit .env.
# ───────────────────────────────────────────────────────────────────────

# Gemini API (dev path — free tier, no GCP project needed)
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Default model for agents (free-tier friendly)
GEMINI_MODEL=gemini-2.5-flash

# Set AIREN_LLM_MODE=mock to bypass Gemini entirely and use canned agent outputs.
# Useful when developing the UI / Slack adapter / etc. and quota is constrained.
# Defaults to "real" (calls Gemini). Set to "mock" to skip LLM calls.
# AIREN_LLM_MODE=mock

# ───────────────────────────────────────────────────────────────────────
#  LLM BACKEND SELECTION
#  Default: gemini. Set to "azure" for dev-only Azure OpenAI fallback.
#  ⚠️ HACKATHON SUBMISSION MUST RUN ON `gemini` — Azure violates contest rules.
# ───────────────────────────────────────────────────────────────────────
AIREN_LLM_BACKEND=gemini

# ───────────────────────────────────────────────────────────────────────
#  AZURE OPENAI — DEV ONLY (set AIREN_LLM_BACKEND=azure to activate)
# ───────────────────────────────────────────────────────────────────────
# AZURE_API_KEY=
# AZURE_API_BASE=https://qa-ai-poc.openai.azure.com/
# AZURE_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Phoenix — local self-hosted (default).
# For hackathon-submission demo we can switch to Phoenix Cloud later.
PHOENIX_PROJECT_NAME=airen-dev
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ───────────────────────────────────────────────────────────────────────
#  Slack — for posting incident reports to a channel
# ───────────────────────────────────────────────────────────────────────
# Bot Token Scopes required: chat:write, chat:write.public, chat:write.customize
# For Concierge chat: also add app_mentions:read, im:history, im:read, im:write
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#airen-test
# Signing secret from Slack App config → Basic Information → Signing Secret
# SLACK_SIGNING_SECRET=...
# Set to 1 ONLY during ngrok-based local dev to skip signature verification
# AIREN_SLACK_SKIP_VERIFY=0

# ───────────────────────────────────────────────────────────────────────
#  Kafka — SECRETS ONLY.  Connection topology (bootstrap_servers, topics,
#  group_id, security_protocol, sasl_mechanism) now lives in
#  services/<svc>/airen.yaml under the `kafka:` block. Only the SASL
#  credentials belong here. See memory/kafka_peek_only.md.
# ───────────────────────────────────────────────────────────────────────
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# (bootstrap_servers null in yaml? then this env is used as a fallback:)
# KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092

# ───────────────────────────────────────────────────────────────────────
#  Redshift — historical predictions + actuals (FK VM required for real)
#  Set AIREN_REDSHIFT_MODE=real on the FK VM; mock by default for laptop.
# ───────────────────────────────────────────────────────────────────────
# Phoenix MCP integration in agent tools (REQUIRED by Arize hackathon track).
# Default ON. Set to 0 if Node/npx isn't available or you want to skip MCP for a run.
AIREN_USE_PHOENIX_MCP=1

AIREN_REDSHIFT_MODE=mock

# ───────────────────────────────────────────────────────────────────────
#  Atlassian / Jira — auto-create incident tickets
#  Real mode requires an API token from https://id.atlassian.com/manage-profile/security/api-tokens
# ───────────────────────────────────────────────────────────────────────
AIREN_JIRA_MODE=mock
# Jira — SECRET ONLY. base_url + user_email now live in airen.yaml (`jira:`).
# Only the API token belongs here.
# AIREN_JIRA_API_TOKEN=ATATT...
# Fallbacks (used only when the yaml field is null):
# AIREN_JIRA_BASE_URL=https://fourkites.atlassian.net
# AIREN_JIRA_USER_EMAIL=akash.lakshmipathy@fourkites.com

# Redshift — SECRET ONLY. host/port/database/user/sslmode/table now live in
# services/<svc>/airen.yaml under `redshift:`. Only the password belongs here.
# REDSHIFT_PASSWORD=
# Fallbacks (used only when the matching yaml field is null):
# REDSHIFT_HOST=
# REDSHIFT_DATABASE=
# REDSHIFT_USER=
# REDSHIFT_DSN=postgresql://USER:PASSWORD@HOST:5439/DATABASE?sslmode=require

# ───────────────────────────────────────────────────────────────────────
#  MLflow — training run lineage (FK VM required for real; VPN-gated)
# ───────────────────────────────────────────────────────────────────────
AIREN_MLFLOW_MODE=mock
# MLflow tracking_uri is a non-secret URL → now in airen.yaml (`mlflow:`).
# FK MLflow is no-auth, so nothing secret is needed here. Fallback only:
# MLFLOW_TRACKING_URI=https://mlflow-dev.fourkites.com

# ───────────────────────────────────────────────────────────────────────
#  PRODUCTION-ONLY (uncomment when we deploy to Cloud Run on Day 16)
# ───────────────────────────────────────────────────────────────────────
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=airen-hackathon-2026
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=~/.airen/sa-key.json
# PHOENIX_API_KEY=px_live_...
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-space>
